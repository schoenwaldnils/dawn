<div id="block-{{ block.id }}">
  {% render 'spider-chart', werkstoff: block.settings.werkstoff %}
</div>


{% schema %}
{
  "name": "Spider Chart",
  "settings": [
    {
      "type": "metaobject",
      "id": "werkstoff",
      "label": "Werkstoff",
      "metaobject_type": "werkstoff"
    }
  ],
  "presets": [
    {
      "name": "Spider Chart",
      "category": "Custom"
    }
  ]
}
{% endschema %}
