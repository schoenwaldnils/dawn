{% doc %}
  @prompt
    Ich möchte alle Produkte einer Kategorie mit allen Filtermöglichkeiten in einer Darstellung für Kunden anzeigen lassen damit diese den kompletten überblick erhalten und nach belieben Filtern können.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    width: 100%;
  }

  .ai-collection-grid-sidebar-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.sidebar_width }}px;
    background-color: {{ block.settings.sidebar_bg_color }};
    padding: 20px;
    border-radius: {{ block.settings.sidebar_border_radius }}px;
  }

  .ai-collection-grid-main-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-collection-grid-header-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-collection-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
  }

  .ai-collection-grid-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-collection-grid-filter-group-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-collection-grid-filter-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 12px;
    color: {{ block.settings.filter_title_color }};
  }

  .ai-collection-grid-filter-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-collection-grid-filter-item-{{ ai_gen_id }} {
    margin-bottom: 8px;
  }

  .ai-collection-grid-filter-label-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 14px;
    color: {{ block.settings.filter_text_color }};
  }

  .ai-collection-grid-filter-checkbox-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-collection-grid-filter-count-{{ ai_gen_id }} {
    margin-left: auto;
    font-size: 12px;
    color: {{ block.settings.filter_count_color }};
  }

  .ai-collection-grid-price-range-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
  }

  .ai-collection-grid-price-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 8px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-collection-grid-clear-filters-{{ ai_gen_id }} {
    margin-top: 16px;
    padding: 10px 16px;
    background-color: {{ block.settings.clear_button_bg }};
    color: {{ block.settings.clear_button_text }};
    border: none;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
    font-size: 14px;
  }

  .ai-collection-grid-clear-filters-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-collection-grid-toolbar-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid {{ block.settings.toolbar_border_color }};
  }

  .ai-collection-grid-count-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.count_text_color }};
  }

  .ai-collection-grid-sort-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-collection-grid-sort-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.sort_label_color }};
  }

  .ai-collection-grid-sort-select-{{ ai_gen_id }} {
    padding: 8px 12px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
  }

  .ai-collection-grid-products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.product_gap }}px;
  }

  .ai-collection-grid-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-collection-grid-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-collection-grid-product-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-collection-grid-product-image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-grid-product-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }

  .ai-collection-grid-product-info-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-collection-grid-product-vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    margin-bottom: 4px;
  }

  .ai-collection-grid-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.product_title_color }};
  }

  .ai-collection-grid-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-grid-product-title-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-collection-grid-product-price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.price_color }};
  }

  .ai-collection-grid-product-compare-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    margin-left: 8px;
  }

  .ai-collection-grid-no-results-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.no_results_color }};
  }

  .ai-collection-grid-no-results-title-{{ ai_gen_id }} {
    font-size: 24px;
    margin: 0 0 12px;
  }

  .ai-collection-grid-no-results-text-{{ ai_gen_id }} {
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-collection-grid-sidebar-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-collection-grid-products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
    }
  }
{% endstyle %}

<collection-filter-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-header-{{ ai_gen_id }}">
    {% if block.settings.show_collection_title and collection.title %}
      <h1 class="ai-collection-grid-title-{{ ai_gen_id }}">{{ collection.title }}</h1>
    {% endif %}
    {% if block.settings.show_collection_description and collection.description != blank %}
      <div class="ai-collection-grid-description-{{ ai_gen_id }}">{{ collection.description }}</div>
    {% endif %}
  </div>

  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% if block.settings.show_filters %}
      <aside class="ai-collection-grid-sidebar-{{ ai_gen_id }}">
        {% if collection.filters.size > 0 %}
          {% for filter in collection.filters %}
            <div class="ai-collection-grid-filter-group-{{ ai_gen_id }}">
              <h3 class="ai-collection-grid-filter-title-{{ ai_gen_id }}">{{ filter.label }}</h3>

              {% if filter.type == 'price_range' %}
                <div class="ai-collection-grid-price-range-{{ ai_gen_id }}">
                  <input
                    type="number"
                    class="ai-collection-grid-price-input-{{ ai_gen_id }}"
                    placeholder="Von"
                    data-filter-type="price-min"
                    min="0"
                  >
                  <span>-</span>
                  <input
                    type="number"
                    class="ai-collection-grid-price-input-{{ ai_gen_id }}"
                    placeholder="Bis"
                    data-filter-type="price-max"
                    min="0"
                  >
                </div>
              {% else %}
                <ul class="ai-collection-grid-filter-list-{{ ai_gen_id }}">
                  {% for value in filter.values %}
                    <li class="ai-collection-grid-filter-item-{{ ai_gen_id }}">
                      <label class="ai-collection-grid-filter-label-{{ ai_gen_id }}">
                        <input
                          type="checkbox"
                          class="ai-collection-grid-filter-checkbox-{{ ai_gen_id }}"
                          data-filter-param="{{ filter.param_name }}"
                          data-filter-value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                        >
                        <span>{{ value.label }}</span>
                        <span class="ai-collection-grid-filter-count-{{ ai_gen_id }}">({{ value.count }})</span>
                      </label>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}

          <button class="ai-collection-grid-clear-filters-{{ ai_gen_id }}" data-clear-filters>
            Alle Filter zurücksetzen
          </button>
        {% endif %}
      </aside>
    {% endif %}

    <main class="ai-collection-grid-main-{{ ai_gen_id }}">
      <div class="ai-collection-grid-toolbar-{{ ai_gen_id }}">
        <div class="ai-collection-grid-count-{{ ai_gen_id }}">
          <span data-product-count>{{ collection.products_count }}</span> Produkte
        </div>

        {% if block.settings.show_sort %}
          <div class="ai-collection-grid-sort-{{ ai_gen_id }}">
            <label class="ai-collection-grid-sort-label-{{ ai_gen_id }}" for="sort-{{ ai_gen_id }}">Sortieren:</label>
            <select
              id="sort-{{ ai_gen_id }}"
              class="ai-collection-grid-sort-select-{{ ai_gen_id }}"
              data-sort-select
            >
              <option value="manual">Empfohlen</option>
              <option value="best-selling">Meistverkauft</option>
              <option value="title-ascending">Alphabetisch, A-Z</option>
              <option value="title-descending">Alphabetisch, Z-A</option>
              <option value="price-ascending">Preis, niedrig zu hoch</option>
              <option value="price-descending">Preis, hoch zu niedrig</option>
              <option value="created-ascending">Datum, alt zu neu</option>
              <option value="created-descending">Datum, neu zu alt</option>
            </select>
          </div>
        {% endif %}
      </div>

      <div class="ai-collection-grid-products-{{ ai_gen_id }}" data-products-container>
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            <div class="ai-collection-grid-product-card-{{ ai_gen_id }}" data-product-card>
              <a href="{{ product.url }}" class="ai-collection-grid-product-image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  <span class="ai-collection-grid-product-badge-{{ ai_gen_id }}">Sale</span>
                {% elsif product.available == false %}
                  <span class="ai-collection-grid-product-badge-{{ ai_gen_id }}">Ausverkauft</span>
                {% endif %}
              </a>

              <div class="ai-collection-grid-product-info-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor %}
                  <div class="ai-collection-grid-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                {% endif %}

                <h3 class="ai-collection-grid-product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <div class="ai-collection-grid-product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-collection-grid-product-compare-price-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="ai-collection-grid-no-results-{{ ai_gen_id }}">
            <h2 class="ai-collection-grid-no-results-title-{{ ai_gen_id }}">Keine Produkte gefunden</h2>
            <p class="ai-collection-grid-no-results-text-{{ ai_gen_id }}">
              Versuchen Sie, Ihre Filter anzupassen oder zurückzusetzen.
            </p>
          </div>
        {% endif %}
      </div>
    </main>
  </div>
</collection-filter-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionFilterGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.filterCheckboxes = this.querySelectorAll('[data-filter-param]');
        this.priceMinInput = this.querySelector('[data-filter-type="price-min"]');
        this.priceMaxInput = this.querySelector('[data-filter-type="price-max"]');
        this.sortSelect = this.querySelector('[data-sort-select]');
        this.clearButton = this.querySelector('[data-clear-filters]');
        this.productsContainer = this.querySelector('[data-products-container]');
        this.productCount = this.querySelector('[data-product-count]');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateFromURL();
      }

      setupEventListeners() {
        this.filterCheckboxes.forEach(checkbox => {
          checkbox.addEventListener('change', () => this.applyFilters());
        });

        if (this.priceMinInput) {
          this.priceMinInput.addEventListener('change', () => this.applyFilters());
        }

        if (this.priceMaxInput) {
          this.priceMaxInput.addEventListener('change', () => this.applyFilters());
        }

        if (this.sortSelect) {
          this.sortSelect.addEventListener('change', () => this.applyFilters());
        }

        if (this.clearButton) {
          this.clearButton.addEventListener('click', () => this.clearFilters());
        }
      }

      updateFromURL() {
        const params = new URLSearchParams(window.location.search);

        this.filterCheckboxes.forEach(checkbox => {
          const paramName = checkbox.dataset.filterParam;
          const paramValue = checkbox.dataset.filterValue;
          const urlValues = params.getAll(paramName);
          checkbox.checked = urlValues.includes(paramValue);
        });

        if (this.sortSelect) {
          const sortValue = params.get('sort_by');
          if (sortValue) {
            this.sortSelect.value = sortValue;
          }
        }
      }

      applyFilters() {
        const params = new URLSearchParams();

        this.filterCheckboxes.forEach(checkbox => {
          if (checkbox.checked) {
            params.append(checkbox.dataset.filterParam, checkbox.dataset.filterValue);
          }
        });

        if (this.priceMinInput && this.priceMinInput.value) {
          params.set('filter.v.price.gte', this.priceMinInput.value);
        }

        if (this.priceMaxInput && this.priceMaxInput.value) {
          params.set('filter.v.price.lte', this.priceMaxInput.value);
        }

        if (this.sortSelect && this.sortSelect.value !== 'manual') {
          params.set('sort_by', this.sortSelect.value);
        }

        const newURL = window.location.pathname + '?' + params.toString();
        window.location.href = newURL;
      }

      clearFilters() {
        this.filterCheckboxes.forEach(checkbox => {
          checkbox.checked = false;
        });

        if (this.priceMinInput) {
          this.priceMinInput.value = '';
        }

        if (this.priceMaxInput) {
          this.priceMaxInput.value = '';
        }

        if (this.sortSelect) {
          this.sortSelect.value = 'manual';
        }

        window.location.href = window.location.pathname;
      }
    }

    customElements.define('collection-filter-grid-{{ ai_gen_id }}', CollectionFilterGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Produktraster mit Filtern",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop-Breite",
      "min": 50,
