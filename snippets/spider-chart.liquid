{% comment %}
  Renders Werkstoff spider chart

  Accepts:
  - werkstoff: {Object} werkstoff meta object.
  Usage:
  {% render 'spider-chart', werkstoff: werkstoff %}
{% endcomment %}

<script src="{{ 'chart.umd.js' | asset_url }}" defer></script>

<div
  class="spider_chart"
  id="spider_chart--{{ werkstoff.id }}"
  data-label="{{ werkstoff.name }}"
  data-fields="
    [
    &quot;{{ werkstoff.schlagzaehigkeit_flexibilitaet }}&quot;,
    &quot;{{ werkstoff.temperaturbestaendigkeit }}&quot;,
    &quot;{{ werkstoff.kosten }}&quot;,
    &quot;{{ werkstoff.farbvielfalt }}&quot;,
    &quot;{{ werkstoff.uv_bestaendigkeit }}&quot;,
    &quot;{{ werkstoff.chemische_bestaendigkeit }}&quot;,
    &quot;{{ werkstoff.oberflaechenqualitaet }}&quot;,
    &quot;{{ werkstoff.steifigkeit }}&quot;,
    &quot;{{ werkstoff.detailgenauigkeit }}&quot;,
    &quot;{{ werkstoff.umweltfreundlichkeit }}&quot;
    ]
  "
></div>

{% javascript %}
  const chartElements = document.querySelectorAll('.spider_chart');

  chartElements.forEach((chartEl) => {
    const label = chartEl.dataset.label;
    const fields = JSON.parse(chartEl.dataset.fields);

    const data = {
      labels: [
        'Schlagzähigkeit/Flexibilitaet',
        'Temperaturbestaendigkeit',
        'Kosten',
        'Farbvielfalt',
        'UV-Bestaendigkeit',
        'Chemische Beständigkeit',
        'Oberflächenqualität',
        'Steifigkeit',
        'Detailgenauigkeit',
        'Umweltfreundlichkeit',
      ],
      datasets: [
        {
          data: fields,
          fill: true,
          backgroundColor: '0089D8',
          // borderColor: 'rgb(255, 99, 132)',
          // pointBackgroundColor: 'rgb(255, 99, 132)',
          // pointBorderColor: '#fff',
          // pointHoverBackgroundColor: '#fff',
          // pointHoverBorderColor: 'rgb(255, 99, 132)'
        },
      ],
    };

    const config = {
      type: 'radar',
      data: data,
      defaults: {
        font: {
          size: 'max(1.1vw, 10px)',
        },
      },
      options: {
        elements: {
          line: {
            borderWidth: 0,
          },
        },
      },
    };

    const chart = new Chart(chartEl, config);
  });
{% endjavascript %}
