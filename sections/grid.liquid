{% schema %}
{
  "name": "Grid",
  "settings": [
    {
      "type": "range",
      "id": "columns_sm",
      "label": "Columns (Small)",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_md",
      "label": "Columns (Medium)",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_lg",
      "label": "Columns (Large)",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Gap",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}